.nav-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  padding: 0 12rpx 10rpx;
}
.nav-bar {
  background: rgba(10, 10, 15, 0.2);
  backdrop-filter: blur(80px) saturate(200%);
  -webkit-backdrop-filter: blur(80px) saturate(200%);
  border: 1rpx solid rgba(255, 255, 255, 0.03);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 84rpx;
}
.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx 4rpx;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}
.nav-item:active { transform: scale(0.88); }
.nav-text {
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.45);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}
.nav-item.active .nav-text {
  color: #ffffff;
  font-weight: 700;
}
.nav-dot-wrap {
  height: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
}
.nav-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #00d4ff;
  animation: dotPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes dotPop {
  from { transform: scale(0); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}