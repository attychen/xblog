<view class="skill-page">
  <view class="container" style="padding-bottom:140rpx;">
    <view style="margin-bottom:24rpx;">
      <text class="text-2xl font-bold text-primary block">Skill 榜单</text>
      <text class="text-sm text-muted block" style="margin-top:6rpx;">GitHub 每日热门开源项目</text>
    </view>

    <view wx:if="{{loading}}" class="text-center" style="padding:80rpx 0;">
      <text class="text-muted">加载中...</text>
    </view>

    <view wx:if="{{!loading}}">
      <view wx:for="{{repos}}" wx:key="id" bindtap="onRepoTap" data-url="{{item.url}}" style="padding:16rpx 0;">
        <view class="flex items-center gap-md" style="margin-bottom:6rpx;">
          <text class="text-xs text-muted font-medium" style="width:48rpx;text-align:right;">#{{index + 1}}</text>
          <text class="text-sm font-semibold text-accent flex-1 truncate">{{item.name}}</text>
        </view>
        <text wx:if="{{item.description}}" class="text-xs text-muted line-clamp-2 block" style="padding-left:48rpx;line-height:1.5;">{{item.description}}</text>
        <view class="flex items-center gap-lg" style="padding-left:48rpx;margin-top:6rpx;">
          <text class="text-xs text-muted">⭐ {{item.stars}}</text>
          <text class="text-xs text-muted">🍴 {{item.forks}}</text>
          <text wx:if="{{item.language}}" class="text-xs text-muted">{{item.language}}</text>
        </view>
        <view wx:if="{{index < repos.length - 1}}" class="divider" style="margin-top:16rpx;"></view>
      </view>
    </view>
  </view>

  <bottom-nav />
</view>