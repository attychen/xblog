.article-page {
  padding: 20rpx 28rpx 180rpx;
}

.article-header {
  margin-bottom: 28rpx;
}

.category-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  background: rgba(168, 85, 247, 0.12);
  border-radius: 8rpx;
  color: #a855f7;
}

.article-tag {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
}

.article-title {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #ffffff;
  display: block;
  letter-spacing: -0.5rpx;
}

.article-divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  margin-bottom: 32rpx;
}

.article-body {
  font-size: 30rpx;
  line-height: 2;
  color: rgba(255, 255, 255, 0.88);
  letter-spacing: 0.3rpx;
}

.article-body p {
  margin-bottom: 32rpx;
  line-height: 2;
  text-align: justify;
}

.article-body h1 {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  margin: 56rpx 0 24rpx;
  line-height: 1.4;
}

.article-body h2 {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  margin: 48rpx 0 20rpx;
  line-height: 1.4;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.article-body h3 {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  margin: 40rpx 0 16rpx;
}

.article-body h4 {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
  margin: 32rpx 0 12rpx;
}

.article-body ul,
.article-body ol {
  padding-left: 36rpx;
  margin-bottom: 28rpx;
}

.article-body li {
  margin-bottom: 14rpx;
  line-height: 1.9;
}

.article-body blockquote {
  border-left: 6rpx solid rgba(168, 85, 247, 0.5);
  padding: 20rpx 24rpx;
  margin: 32rpx 0;
  background: rgba(168, 85, 247, 0.06);
  border-radius: 0 12rpx 12rpx 0;
  color: rgba(255, 255, 255, 0.75);
  font-style: italic;
  line-height: 1.8;
}

.article-body code {
  font-family: SFMono-Regular, Menlo, monospace;
  font-size: 26rpx;
  background: rgba(168, 85, 247, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  color: #c084fc;
  border: 1rpx solid rgba(168, 85, 247, 0.15);
}

.article-body pre {
  background: rgba(0, 0, 0, 0.5);
  padding: 28rpx;
  border-radius: 16rpx;
  overflow-x: auto;
  margin: 32rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}

.article-body pre code {
  background: transparent;
  padding: 0;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.85);
  border: none;
}

.article-body a {
  color: #00d4ff;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.article-body img {
  max-width: 100%;
  border-radius: 12rpx;
  margin: 28rpx 0;
}

.article-body table {
  width: 100%;
  border-collapse: collapse;
  margin: 28rpx 0;
  font-size: 26rpx;
}

.article-body th,
.article-body td {
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 14rpx 16rpx;
  text-align: left;
}

.article-body th {
  background: rgba(255, 255, 255, 0.05);
  font-weight: 600;
}

.article-body hr {
  border: none;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.1);
  margin: 40rpx 0;
}
/* Code blocks with line numbers */
.code-block {
  background: rgba(0, 0, 0, 0.5);
  padding: 24rpx 0;
  border-radius: 16rpx;
  overflow-x: auto;
  margin: 32rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}

.code-block code {
  display: block;
  font-family: SFMono-Regular, Menlo, monospace;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.85);
  padding: 0;
  background: transparent;
  border: none;
}

.code-line {
  display: flex;
  padding: 0 20rpx;
  min-height: 36rpx;
}

.code-line:hover {
  background: rgba(255, 255, 255, 0.03);
}

.line-num {
  display: inline-block;
  width: 48rpx;
  min-width: 48rpx;
  color: rgba(255, 255, 255, 0.25);
  text-align: right;
  padding-right: 20rpx;
  user-select: none;
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 36rpx;
}

.line-content {
  flex: 1;
  padding-left: 12rpx;
  white-space: pre;
  overflow-x: auto;
}

.inline-code {
  font-family: SFMono-Regular, Menlo, monospace;
  font-size: 26rpx;
  background: rgba(168, 85, 247, 0.1);
  padding: 3rpx 10rpx;
  border-radius: 6rpx;
  color: #c084fc;
  border: 1rpx solid rgba(168, 85, 247, 0.15);
}
.article-footer {
  margin-top: 48rpx;
  padding-bottom: 20rpx;
}

.copy-link-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.7);
  transition: all 0.2s ease;
}

.copy-link-btn:active {
  background: rgba(255, 255, 255, 0.12);
  transform: scale(0.95);
}